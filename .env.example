# ============================================
# CodePath Frontend - Environment Variables
# ============================================
# Copy this file to .env.local and update with your values
# Command: cp .env.example .env.local

# ============================================
# API Configuration
# ============================================

# Backend API Base URL (Express, no /api prefix)
# Local Node backend: http://localhost:3000
# Production: https://api.codepath.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ============================================
# Mock API Configuration
# ============================================

# Use Mock API for Development
# Set to "true" to use mock data (no backend needed)
# Set to "false" to use real backend API
NEXT_PUBLIC_USE_MOCK_API=false

# ============================================
# WebSocket Configuration
# ============================================

# WebSocket URL for Real-time Features
# Used for live scoreboard, contest updates, etc.
# Local Node backend: ws://localhost:3000
# Production: wss://api.codepath.com
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ============================================
# External API Integration (Optional)
# ============================================

# Codeforces API URL
# Used for syncing Codeforces data
# Default: https://codeforces.com/api
NEXT_PUBLIC_CODEFORCES_API_URL=https://codeforces.com/api

# LeetCode API URL
# Used for syncing LeetCode data
# Default: https://leetcode.com/api
NEXT_PUBLIC_LEETCODE_API_URL=https://leetcode.com/api

# ============================================
# Application Configuration (Optional)
# ============================================

# Application Name
# Used for metadata and branding
NEXT_PUBLIC_APP_NAME=CodePath

# Application URL
# Used for generating absolute URLs
# Frontend runs on port 3001 locally (Node backend uses 3000)
# Production: https://codepath.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable Dark Mode
# Set to "true" to enable dark mode toggle
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Enable Analytics
# Set to "true" to enable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false
